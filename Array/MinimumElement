  int search(vector<int>& nums, int target) {
        int left = 0;
        int right = nums.size() - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;       //  mid nikale 

            if (nums[mid] == target) {
                return mid;
            }
            else if (nums[mid] < target) {             // left wala aage badhao 
                left = mid + 1;
            }
            else {
                right = mid - 1;                    //right wala kam kro 
            }
        }

        return -1;
    }
};
